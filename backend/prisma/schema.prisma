// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum UserRole {
  CITIZEN
  ADMIN
  RELIEF_TEAM
  RELIEF_COORDINATOR
}

enum RequestType {
  FOOD
  WATER
  MEDICINE
  SHELTER
}

enum RequestStatus {
  PENDING
  ASSIGNED
  IN_PROGRESS
  COMPLETED
  REJECTED
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum VulnerableGroup {
  NONE
  CHILDREN
  WOMEN
  ELDERLY
  DISABLED
}

enum TeamStatus {
  AVAILABLE
  BUSY
  OFFLINE
}

model User {
  id       Int      @id @default(autoincrement())
  name     String
  email    String   @unique
  password String
  phone    String?
  role     UserRole @default(CITIZEN)

  requests  ReliefRequest[]
  createdAt DateTime        @default(now())
  updatedAt DateTime        @updatedAt
}

model ReliefTeam {
  id            Int        @id @default(autoincrement())
  teamName      String
  leaderName    String
  contactNumber String
  status        TeamStatus @default(AVAILABLE)

  assignedRequests ReliefRequest[]
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
}

model ReliefRequest {
  id              Int             @id @default(autoincrement())
  requestType     RequestType
  description     String
  address         String
  latitude        Float?
  longitude       Float?
  peopleAffected  Int
  contactNumber   String
  imageUrl        String?
  vulnerableGroup VulnerableGroup @default(NONE)
  priority        Priority        @default(MEDIUM)
  status          RequestStatus   @default(PENDING)

  createdById    Int
  createdBy      User        @relation(fields: [createdById], references: [id])
  assignedTeamId Int?
  assignedTeam   ReliefTeam? @relation(fields: [assignedTeamId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
