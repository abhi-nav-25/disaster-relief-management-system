# ==============================================================================
# Disaster Relief Management System (DRMS) - Backend Environment Template
# ==============================================================================
# Copy this file to .env and replace the placeholder values with your configuration.
# DO NOT commit the real .env file with actual credentials to version control.

# Server Port (default: 5000)
PORT=5000

# PostgreSQL Connection URL
# Format: postgresql://<USER>:<PASSWORD>@<HOST>:<PORT>/<DATABASE>?schema=<SCHEMA>
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/drms_db?schema=public"

# JSON Web Token Secret for signing authentication tokens
JWT_SECRET="your_secure_jwt_secret_key_here"
